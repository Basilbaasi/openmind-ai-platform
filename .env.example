# ── Environment ──────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# The application reads these via pydantic-settings.

# Application
APP_NAME=OpenMind AI Platform
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# API
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://openmind:openmind@localhost:5432/openmind

# AI / LLM Providers
GEMINI_API_KEY=your-gemini-api-key-here

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Security
API_KEY_HEADER=Authorization

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=["*"]